{
  // CAD Viewer DEV preview for Claude Code — repo developer workflow ONLY.
  //
  // Runs the Vite dev server (HMR) for iteration. None of this is part of the
  // cad-viewer skill; a skill consumer just runs `npm run start` (the built
  // bundle). For a production/e2e check, run `npm run build` then
  // `npm run start` (see AGENTS.md) instead of this preview.
  //
  // Fixed port 3245: dev and start both listen where you tell them and fail on
  // a taken port rather than rolling to another. To run a second Viewer, start
  // it yourself with `npm --prefix viewer run dev -- --port <n>`.
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cad-viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "viewer", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 3245
    },
    {
      // Docs site (Next.js). `npm run check` builds it; this serves it with HMR.
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docs", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
