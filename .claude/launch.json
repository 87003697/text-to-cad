{
  // CAD Viewer DEV preview for Claude Code — repo developer workflow ONLY.
  //
  // Runs the Vite dev server (HMR) for iteration, via scripts/dev/
  // viewer-preview.sh. None of this is part of the cad-viewer skill; a skill
  // consumer just runs `npm run start` (the built bundle on 3245).
  //
  // autoPort gives each worktree/branch its own dev Viewer: 3245 when free, else
  // a free port Claude exports as $PORT, which the wrapper forwards to Vite.
  //
  // For a production/e2e check, run `npm run build` then `npm run start` (see
  // AGENTS.md) instead of this preview.
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cad-viewer",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/dev/viewer-preview.sh"],
      "port": 3245,
      "autoPort": true
    }
  ]
}
