{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAD Viewer",
  "version": "0.0.0",
  "identifier": "com.texttocad.cad-viewer",
  "build": {
    "beforeDevCommand": "npm --prefix ../viewer run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CAD Viewer",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cad-viewer-backend"
    ],
    "resources": {
      "python/runtime": "runtime"
    },
    "fileAssociations": [
      {
        "ext": ["step", "stp"],
        "name": "STEP CAD model",
        "description": "STEP CAD exchange file",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
