# macOS
.DS_Store
/.cvm-browser-runtime/
.vscode

# Python
__pycache__/
*.py[cod]
# Per-folder cadgen output home; rebuilt on demand.
__cadgen__/
*.egg-info/
*.so
*.dylib
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.python-version

# Local environments and caches
.venv
.cache
.agents/
graphify-out/
.vite
node_modules
dist
coverage

# Production CAD Viewer runtime dist is committed on main. On dev,
# skills/cad-viewer/scripts/viewer must stay a symlink to viewer/.
!skills/cad-viewer/scripts/viewer/dist/
!skills/cad-viewer/scripts/viewer/dist/**

# Temporary files
*.tmp
*.swp
*.step.glb.lock
*.stp.glb.lock
tmp/

# Pilot/experiment outputs (not committed; use models/ for durable artifacts)
outputs
outputs/
.cvm-jobs/
.cvm-agent-jobs/

# Review media rendered next to a fixture. models/ holds CAD/robot sources,
# durable generated artifacts, mesh-processing fixtures, and docs only; see
# models/README.md.
models/**/*.png
models/**/*.jpg
models/**/*.jpeg
models/**/*.gif
models/**/*.webp
models/**/*.avif
models/**/*.bmp
models/**/*.tif
models/**/*.tiff
models/**/*.svg
models/**/*.mp4
models/**/*.mov
models/**/*.webm
models/**/*.mkv

# Local printer credentials
/bambu-printers.json

# Fun models (large generated artifacts)
models/fun/

# Local-only pilot benchmark inputs (not committed)
models/toys4k/

# Component-GLB render packages are regenerated on demand.
.*.step.glb/
.*.step.glb
.*.stp.glb/
.*.stp.glb
